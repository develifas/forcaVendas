# ==============================================================================
# FV PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Configure os valores correspondentes ao seu ambiente (dev, homologação ou produção)
# IMPORTANTE: Nunca envie este arquivo com valores reais para o controle de versão.

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Chave anônima pública (segura para o browser com RLS ativa)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de serviço administrativa (EXCLUSIVA DO SERVIDOR - NUNCA expor no cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------------------------
# URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# OBSERVABILITY & SENTRY
# ------------------------------------------------------------------------------
# Sentry DSN para captura de erros e tracing
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=sntrys_...

